// nvnvk final color pass: contrast-adaptive sharpening (`sharpen` option; AMD CAS idea, own implementation),
// brightness/contrast/saturation (`brightness`, `contrast`, `saturation`) and FPS counter (`show_fps`).
// Reads the previous image in the chain (sampled: sRGB arrives linear) and writes RGBA16F.
// glslangValidator -V --vn kFinalSpv -o final.comp.inc final.comp
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D dst;
layout(push_constant) uniform Pc {
    ivec2 size;
    float sharpness;   // 0 = no sharpening; 0..1
    float brightness;  // added (-0.5..0.5)
    float contrast;    // 1 = unchanged
    float saturation;  // 1 = unchanged; 0 = grayscale
    int fps;           // < 0: no counter
    int pad;
} pc;

vec3 tap(ivec2 p) { return texelFetch(src, clamp(p, ivec2(0), pc.size - 1), 0).rgb; }

// 3x5 digits (bit 14 = top left, row-major).
const int kDigits[10] = int[](0x7B6F, 0x2C97, 0x73E7, 0x73CF, 0x5BC9, 0x79CF, 0x79EF, 0x7249, 0x7BEF, 0x7BCF);

// FPS counter at the top left: returns true on digit pixels and marks the background box.
bool FpsPixel(ivec2 p, out bool bg) {
    bg = false;
    if (pc.fps < 0) return false;
    const int s = max(2, pc.size.y / 270);  // size of a digit "pixel"
    const ivec2 o = ivec2(4 * s);
    const int n = pc.fps >= 100 ? 3 : (pc.fps >= 10 ? 2 : 1);
    if (p.x < o.x - s || p.y < o.y - s || p.x >= o.x + n * 4 * s || p.y >= o.y + 6 * s) return false;
    bg = true;
    if (p.x < o.x || p.y < o.y) return false;
    const ivec2 q = (p - o) / s;
    if (q.y >= 5) return false;
    const int idx = q.x / 4, col = q.x % 4;
    if (col == 3) return false;
    int v = pc.fps;
    for (int i = n - 1; i > idx; --i) v /= 10;
    const int bits = kDigits[v % 10];
    return ((bits >> (14 - (q.y * 3 + col))) & 1) != 0;
}

void main() {
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.size.x || p.y >= pc.size.y) return;
    const vec4 e4 = texelFetch(src, p, 0);
    vec3 c = e4.rgb;
    if (pc.sharpness > 0.0) {
        const vec3 b = tap(p + ivec2(0, -1)), d = tap(p + ivec2(-1, 0)), f = tap(p + ivec2(1, 0)), h = tap(p + ivec2(0, 1));
        const vec3 mn = min(min(min(b, d), min(f, h)), c);
        const vec3 mx = max(max(max(b, d), max(f, h)), c);
        // Amount: little where contrast is already high (avoids halos), more in smooth areas.
        const vec3 amp = sqrt(clamp(min(mn, 1.0 - mx) / max(mx, vec3(1e-5)), 0.0, 1.0));
        const vec3 w = -amp / mix(8.0, 5.0, clamp(pc.sharpness, 0.0, 1.0));
        c = clamp((c + w * (b + d + f + h)) / (1.0 + 4.0 * w), 0.0, 1.0);
    }
    if (pc.contrast != 1.0 || pc.brightness != 0.0) c = (c - 0.5) * pc.contrast + 0.5 + pc.brightness;
    if (pc.saturation != 1.0) c = mix(vec3(dot(c, vec3(0.2126, 0.7152, 0.0722))), c, pc.saturation);
    c = clamp(c, 0.0, 1.0);
    bool bg;
    if (FpsPixel(p, bg)) c = vec3(1.0, 1.0, 0.3);
    else if (bg) c *= 0.35;
    imageStore(dst, p, vec4(c, e4.a));
}
