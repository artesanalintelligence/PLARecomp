// plahost version information (no icon here: the installer embeds the game's icon from the user's dump).
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PLARecomp"
            VALUE "FileDescription", "PLARecomp"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "PLA"
            VALUE "LegalCopyright", "PLARecomp contributors, GPL-3.0-or-later"
            VALUE "OriginalFilename", "PLA.exe"
            VALUE "ProductName", "PLARecomp"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
